{
  "name": "NPO-Automotive",
  "version": "1.0.0",
  "description": "Factory Manufacturing Management System",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "echo 'No pretest script'",
    "test": "npx playwright test",
    "api:coverage": "node scripts/check-api-coverage.mjs",
    "api:defensive-coverage": "node scripts/check-defensive-coverage.mjs",
    "api:parallel-safe": "cross-env TEST_SUITE=api_parallel_safe_tests playwright test --workers=2",
    "api:serial-heavy": "cross-env TEST_SUITE=api_serial_heavy_tests playwright test --workers=1",
    "api:split": "pnpm run api:parallel-safe && pnpm run api:serial-heavy",
    "test:parallel": "cross-env TEST_SUITE=parallel npx playwright test",
    "ui": "pnpm exec playwright test --ui",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "deploy:gh-pages": "npx gh-pages -d playwright-report",
    "deploy:gh-pages:allure": "pnpm run allure:generate && npx gh-pages -d allure-report"
  },
  "author": "Your Name",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^14.14.31",
    "allure-commandline": "^2.32.2",
    "allure-js-commons": "^3.1.0",
    "allure-playwright": "^3.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "gh-pages": "^6.2.0",
    "lz-string": "^1.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
